{
  "name": "facturador",
  "version": "1.1.0",
  "private": true,
  "description": "Facturación sencilla para autónomos y pymes en España. Open source (MIT).",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node scripts/supervisor.mjs",
    "start:directo": "node server/index.mjs",
    "release": "node scripts/crear-release.mjs",
    "instalador:windows": "node scripts/crear-instalador-windows.mjs",
    "manual": "node scripts/generar-manual.mjs",
    "test": "node --test server/test/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.2.1",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.2"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "^3.7.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
